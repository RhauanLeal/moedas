# Copie para .env e preencha:  cp .env.example .env

# Porta exposta no servidor, só em 127.0.0.1 (escolha uma livre)
PORTA=8030

# --- Django ---
# Gere uma chave com:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=False

# Fase de testes (rede de casa):
DJANGO_ALLOWED_HOSTS=192.168.30.6,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.30.6:8010
DJANGO_SECURE_COOKIES=False

# Produção (Cloudflare Tunnel) — troque as três linhas acima por:
# DJANGO_ALLOWED_HOSTS=moedas.linario.dev.br,192.168.30.6,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=https://moedas.linario.dev.br
# DJANGO_SECURE_COOKIES=True

# --- Contas ---
# False fecha novos cadastros (quem já tem conta continua entrando)
CADASTRO_ABERTO=True
# none = entra direto após cadastrar | mandatory = exige confirmar e-mail (precisa de SMTP abaixo)
ACCOUNT_EMAIL_VERIFICATION=none

# Login com Google (Google Cloud Console › APIs e serviços › Credenciais). Vazio = botão não aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login com Microsoft (portal.azure.com › Microsoft Entra ID › Registros de aplicativo). Vazio = botão não aparece.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Login com Apple (exige Apple Developer Program, pago, e HTTPS). Vazio = botão não aparece.
# APPLE_PRIVATE_KEY = conteúdo do arquivo .p8 em UMA linha, com \n no lugar das quebras de linha.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Notificações (gere com: docker compose exec moedas python manage.py gerar_chaves_push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# E-mail para "esqueci a senha" (opcional; sem isso o e-mail só aparece no log)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# E-mail de contato exibido na política de privacidade
CONTATO_EMAIL=

# Doação por Pix (aparece em "Minha conta"). Chave vazia = cartão escondido.
PIX_CHAVE=
PIX_NOME=
PIX_CIDADE=

# Usuário de login criado na primeira subida
DJANGO_SUPERUSER_USERNAME=rhauan
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha
DJANGO_SUPERUSER_EMAIL=

# --- Banco ---
# Homelab: descomente COMPOSE_FILE e REDE_BANCO e use o nome/porta interna do container do Postgres.
# Dev com túnel SSH: DB_HOST=host.docker.internal e DB_PORT=<porta local do túnel>; deixe as duas linhas comentadas.
# COMPOSE_FILE=docker-compose.yml:docker-compose.homelab.yml
# Rede Docker do container do Postgres (veja com: docker inspect <container> --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}')
# REDE_BANCO=nome-da-rede-do-postgres
# Nome do container do Postgres e porta INTERNA dele (5432)
DB_HOST=nome-do-container-postgres
DB_PORT=5432
DB_NAME=moedas
DB_USER=moedas
DB_PASSWORD=troque-esta-senha-do-banco
